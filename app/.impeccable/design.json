  "narrative": {
    "northStar": "The website comes home",
    "overview": "Kitty extends its established website identity into a small-screen operating app: white space, deep pink actions, blush surfaces, expressive local type and a warm cat room. Friendly shapes frame financial information without obscuring amounts, obligations or next steps.\n\nThe welcome scene uses the website’s shaded pink brand cat. Account and standing surfaces retain the deterministic six-coat companion and six-stage model, using the original website cat’s facial geometry and seated proportions. These are distinct asset roles within one identity. The standing poses use a low supported crouch with staggered forepaws, a box peek with separate draped paws, a tucked loaf and a side recline with distinct shoulder and hip anatomy. This record describes the finished local web Wary and Family correction; native authentication, screen readers and device behavior require separate verification.",
    "keyCharacteristics": [
      "White canvas with blush task surfaces.",
      "Deep pink actions and explicit financial labels.",
      "Bricolage Grotesque headings paired with Figtree reading text.",
      "Flat controls, soft corners and warm companion scenery."
    ],
    "rules": [
      {
        "name": "The Written Status Rule",
        "body": "Pair every status color or progress bar with readable words or counts.",
        "section": "colors"
      },
      {
        "name": "The Two Cats Rule",
        "body": "Use the website brand scene for welcome; preserve the member’s deterministic standing cat on companion surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared theme and UI primitives for additional app surfaces.",
      "Do keep amounts, testnet disclosures, obligations and retry language readable.",
      "Do preserve wrapping, font scaling, labelled controls and at least 48dp interaction targets.",
      "Do keep standing terms and next steps available when the cat is hidden."
    ],
    "donts": [
      "Don’t substitute the welcome brand cat for a member’s standing cat.",
      "Don’t turn unknown amounts into zero or report success before confirmation.",
      "Don’t animate routine navigation or loop decorative balance or cat motion."
    ]
  }
