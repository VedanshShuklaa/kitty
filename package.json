{
  "name": "kitty",
  "private": true,
  "version": "0.1.0",
  "description": "Kitty — a rotating savings circle on Monad",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.0",
  "scripts": {
