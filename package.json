{
  "name": "kitty",
  "private": true,
  "version": "0.1.0",
  "description": "Kitty — a rotating savings circle on Monad",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "test": "pnpm -r test",
    "test:contracts": "cd contracts && forge test",
    "test:indexer": "pnpm --filter indexer test",
    "test:services": "pnpm --filter services test",
    "test:app": "pnpm --filter app test",
    "lint": "pnpm -r lint",
    "keeper": "pnpm --filter services keeper",
    "demo:check": "pnpm --filter services demo:check",
    "demo:watch": "pnpm --filter services demo:watch",
    "demo:crew": "pnpm --filter services demo:crew"
  }
}
